{
    "buildCommand": "pnpm run build",
    "outputDirectory": "build",
    "installCommand": "pnpm install",
    "framework": null,
    "rewrites": [
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=7200"
          }
        ]
      },
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2629744"
          }
        ]
      }
    ]
  }